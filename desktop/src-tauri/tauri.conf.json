{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vortex",
  "version": "1.0.0",
  "identifier": "tech.vetorial.vortex",
  "build": {
    "beforeBuildCommand": "cd ../app && npm run build",
    "beforeDevCommand": "cd ../app && npm run dev",
    "devUrl": "http://localhost:5178",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vortex",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://venus-servidor.tonysantquees95.workers.dev https://api.github.com https://en.wikipedia.org https://pt.wikipedia.org https://www.wikidata.org; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] }
    }
  }
}
